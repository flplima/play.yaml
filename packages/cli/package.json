{
  "name": "@play.yaml/cli",
  "version": "1.0.0",
  "description": "CLI player for play.yaml scores using webaudio-node",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "play-yaml": "./dist/export.js",
    "play-yaml-play": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "start": "tsx src/cli.ts",
    "play": "tsx src/cli.ts ../../examples/my-score.play.yaml",
    "test": "tsc --noEmit",
    "verify-midi": "tsx src/verify-midi.ts"
  },
  "dependencies": {
    "@play.yaml/core": "^1.0.0",
    "easymidi": "^3.2.0",
    "webaudio-node": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "license": "MIT"
}
