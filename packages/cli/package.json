{
  "name": "@play.yaml/cli",
  "version": "1.0.0",
  "description": "CLI player for play.yaml scores",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "play-yaml": "./dist/export.js",
    "play-yaml-play": "./dist/cli.js",
    "play-yaml-fidelity": "./dist/fidelity.js",
    "play-yaml-import": "./dist/import-midi.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "start": "tsx src/cli.ts",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@play.yaml/core": "^1.0.0",
    "@play.yaml/node-audio": "^1.0.0",
    "easymidi": "^3.2.0",
    "jsdom": "^31.0.1",
    "opensheetmusicdisplay": "^2.3.1",
    "pdfkit": "^0.20.2",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "license": "MIT"
}
