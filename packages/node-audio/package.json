{
  "name": "@play.yaml/node-audio",
  "version": "1.0.0",
  "description": "Offline rendering and speaker playback of play.yaml scores on Node",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "tsc --noEmit && tsx test.ts"
  },
  "dependencies": {
    "@play.yaml/core": "^1.0.0",
    "node-web-audio-api": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "license": "MIT"
}
