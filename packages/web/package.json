{
  "name": "@play.yaml/web",
  "version": "1.0.0",
  "description": "Browser editor & player for play.yaml scores",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pm2 startOrRestart ecosystem.config.cjs",
    "dev:vite": "vite",
    "dev:stop": "pm2 delete play-yaml-web",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "logs": "pm2 logs play-yaml-web --nostream --lines 100",
    "logs:follow": "pm2 logs play-yaml-web",
    "test": "tsc --noEmit",
    "serve": "tsx server.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@play.yaml/core": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uiw/react-codemirror": "^4.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.30.0",
    "opensheetmusicdisplay": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  },
  "license": "MIT"
}
